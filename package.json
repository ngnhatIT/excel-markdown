{
  "build": {
    "appId": "com.excel2md.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false,
      "shortcutName": "ExcelToMarkdown"
    },
    "productName": "ExcelToMarkdown",
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        }
      ]
    }
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jszip": "^3.10.1",
    "marked": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "description": "Convert file Excel sang Markdown trên Windows",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "main": "out/main/index.js",
  "name": "excel-to-md",
  "private": true,
  "scripts": {
    "build": "electron-vite build",
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "dist": "electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "e2e": "electron-vite build && node scripts/e2e.mjs"
  },
  "version": "2.2.0",
  "license": "MIT"
}
