{
  "build": {
    "appId": "com.excel2md.app",
    "productName": "ExcelToMarkdown",
    "copyright": "Copyright © 2026 Nguyen Khanh Nhat",
    "artifactName": "ExcelToMarkdown-Setup-${version}.${ext}",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "*.cmd"
        ]
      }
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false,
      "shortcutName": "ExcelToMarkdown",
      "include": "resources/installer.nsh",
      "installerLanguages": [
        "en_US",
        "ja_JP",
        "vi_VN"
      ],
      "language": "1033",
      "multiLanguageInstaller": true
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "exceljs": "4.4.0",
    "jszip": "^3.10.1",
    "marked": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "description": "Convert file Excel sang Markdown trên Windows",
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "mermaid": "12.2.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "main": "out/main/index.js",
  "name": "excel-to-md",
  "private": true,
  "scripts": {
    "build": "electron-vite build",
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "dist": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "e2e": "electron-vite build && node scripts/e2e.mjs"
  },
  "version": "2.3.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "author": "Nguyen Khanh Nhat",
  "homepage": "https://github.com/ngnhatIT/excel-markdown",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngnhatIT/excel-markdown.git"
  }
}
